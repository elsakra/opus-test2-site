---
---

<section class="section-animate py-20 md:py-28 lg:py-32 bg-beige-light/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <h2 class="fade-up text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
        Conveniently located in
        <span class="text-teal-primary">Southaven</span>
      </h2>
      <p class="fade-up animate-delay-100 text-lg md:text-xl text-gray-medium">
        Easy access with ample parking below the children's clinic
      </p>
    </div>
    
    <div class="grid lg:grid-cols-2 gap-12 items-start">
      <div class="fade-up animate-delay-200 space-y-8">
        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-semibold mb-6">Office Hours</h3>
          <div class="space-y-3">
            <div class="flex justify-between items-center py-2 border-b border-gray-100">
              <span class="font-medium">Monday & Wednesday</span>
              <span class="text-gray-medium">7:00 AM - 5:00 PM</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-100">
              <span class="font-medium">Tuesday & Thursday</span>
              <span class="text-gray-medium">8:00 AM - 5:00 PM</span>
            </div>
            <div class="flex justify-between items-center py-2 border-b border-gray-100">
              <span class="font-medium">Friday</span>
              <span class="text-gray-medium">7:00 AM - 11:00 AM</span>
            </div>
          </div>
          <div class="mt-6 p-4 bg-teal-accent/10 rounded-xl">
            <p class="text-sm text-teal-primary font-medium">
              <svg class="inline w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
              </svg>
              15 same-day appointments available daily
            </p>
          </div>
        </div>
        
        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-semibold mb-6">Contact Information</h3>
          <div class="space-y-4">
            <a href="tel:6623491999" class="flex items-center gap-4 group">
              <div class="w-12 h-12 bg-teal-accent/20 rounded-full flex items-center justify-center group-hover:bg-teal-accent/30 transition-colors">
                <svg class="w-6 h-6 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-medium">Phone</p>
                <p class="font-semibold text-lg group-hover:text-teal-primary transition-colors">(662) 349-1999</p>
              </div>
            </a>
            
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 bg-teal-accent/20 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-medium">Fax</p>
                <p class="font-semibold text-lg">(662) 349-9734</p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 bg-teal-accent/20 rounded-full flex items-center justify-center flex-shrink-0">
                <svg class="w-6 h-6 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                </svg>
              </div>
              <div>
                <p class="text-sm text-gray-medium">Address</p>
                <p class="font-semibold text-lg">7680 Airways Blvd.<br>Southaven, MS 38671</p>
              </div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="fade-up animate-delay-300">
        <div class="bg-white rounded-2xl overflow-hidden shadow-lg">
          <img 
            src="https://res.cloudinary.com/dil14r8je/image/upload/v1768346068/auto-site-builder/opus-test2/image_8.jpg" 
            alt="Office location map"
            class="w-full h-64 object-cover"
          />
          <div class="p-8">
            <h3 class="text-xl font-semibold mb-4">Directions</h3>
            <p class="text-gray-medium mb-4">Our office is located below the children's clinic. Look for the entrance and ample parking available.</p>
            <a href="https://maps.google.com/?q=7680+Airways+Blvd+Southaven+MS+38671" target="_blank" class="btn-primary">
              Get Directions
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>