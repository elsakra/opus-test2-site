---
const currentYear = new Date().getFullYear();
---

<footer class="bg-navy text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 mb-12">
      <div class="space-y-4">
        <h3 class="text-2xl font-bold">Southaven Internal Medicine</h3>
        <p class="text-gray-400">Dedicated to our patients since 1996</p>
        <div class="flex gap-4">
          <a href="https://www.facebook.com/southaveninternalmedicine" class="w-10 h-10 bg-white/10 rounded-full flex items-center justify-center hover:bg-white/20 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="#services" class="text-gray-400 hover:text-white transition-colors">Our Services</a></li>
          <li><a href="#about" class="text-gray-400 hover:text-white transition-colors">About Us</a></li>
          <li><a href="#providers" class="text-gray-400 hover:text-white transition-colors">Meet Our Providers</a></li>
          <li><a href="#portal" class="text-gray-400 hover:text-white transition-colors">Patient Portal</a></li>
        </ul>
      </div>
      
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Contact Info</h4>
        <ul class="space-y-2 text-gray-400">
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <a href="tel:6623491999" class="hover:text-white transition-colors">(662) 349-1999</a>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
            </svg>
            <span>Fax: (662) 349-9734</span>
          </li>
          <li class="flex items-start gap-2">
            <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>7680 Airways Blvd.<br>Southaven, MS 38671</span>
          </li>
        </ul>
      </div>
      
      <div class="space-y-4">
        <h4 class="text-lg font-semibold">Office Hours</h4>
        <ul class="space-y-2 text-gray-400 text-sm">
          <li>Mon & Wed: 7:00 AM - 5:00 PM</li>
          <li>Tue & Thu: 8:00 AM - 5:00 PM</li>
          <li>Friday: 7:00 AM - 11:00 AM</li>
        </ul>
        <div class="pt-4">
          <a href="https://mycw144.ecwcloud.com/portal20180/jsp/100mp/login_otp.jsp" class="btn-secondary text-sm">
            Patient Portal Login
          </a>
        </div>
      </div>
    </div>
    
    <div class="border-t border-white/10 pt-8">
      <p class="text-center text-gray-400 text-sm">
        © {currentYear} Southaven Internal Medicine. All rights reserved.
      </p>
    </div>
  </div>
</footer>