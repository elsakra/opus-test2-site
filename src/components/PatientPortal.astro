---
---

<section class="section-animate py-20 md:py-28 lg:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-gradient-to-br from-teal-primary to-teal-accent rounded-3xl overflow-hidden">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="p-12 lg:p-16 text-white space-y-6">
          <div class="space-y-4">
            <h2 class="fade-up text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight">
              Access your health
              <span class="block">anytime, anywhere</span>
            </h2>
            <p class="fade-up animate-delay-100 text-xl text-white/90">
              Our patient portal and Healow app give you secure 24/5 access to your health information
            </p>
          </div>
          
          <div class="space-y-4">
            <div class="fade-up animate-delay-200 flex items-start gap-4">
              <div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-lg mb-1">View Test Results</h3>
                <p class="text-white/80">Access your lab results as soon as they're available</p>
              </div>
            </div>
            
            <div class="fade-up animate-delay-300 flex items-start gap-4">
              <div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-lg mb-1">Request Prescription Refills</h3>
                <p class="text-white/80">Easily request refills for your medications online</p>
              </div>
            </div>
            
            <div class="fade-up animate-delay-300 flex items-start gap-4">
              <div class="w-6 h-6 bg-white/20 rounded-full flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="font-semibold text-lg mb-1">Message Your Provider</h3>
                <p class="text-white/80">Communicate securely with your healthcare team</p>
              </div>
            </div>
          </div>
          
          <div class="fade-up animate-delay-300 pt-4">
            <a href="https://mycw144.ecwcloud.com/portal20180/jsp/100mp/login_otp.jsp" class="inline-flex items-center justify-center px-8 py-3 text-base font-medium text-teal-primary bg-white rounded-full transition-all duration-300 hover:scale-105">
              Access Patient Portal
              <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>
        </div>
        
        <div class="relative hidden lg:block">
          <div class="absolute inset-0 bg-gradient-to-br from-white/10 to-transparent"></div>
          <img 
            src="https://res.cloudinary.com/dil14r8je/image/upload/v1768346068/auto-site-builder/opus-test2/image_6.jpg" 
            alt="Patient using portal"
            class="w-full h-full object-cover"
          />
        </div>
      </div>
    </div>
  </div>
</section>