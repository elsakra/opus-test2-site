---
const services = [
  {
    icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
    title: 'Preventative Medicine',
    description: 'Comprehensive health screenings and preventive care to keep you healthy'
  },
  {
    icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
    title: 'Patient Portal',
    description: 'Access test results, request refills, and connect with your physician online'
  },
  {
    icon: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
    title: 'Telehealth Options',
    description: 'Secure video consultations available for your convenience'
  },
  {
    icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
    title: 'On-Site Lab',
    description: 'Convenient blood work and testing right in our office'
  }
];
---

<section class="section-animate py-20 md:py-28 lg:py-32 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <h2 class="fade-up text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight mb-4">
        Comprehensive care for
        <span class="text-teal-primary">your whole health</span>
      </h2>
      <p class="fade-up animate-delay-100 text-lg md:text-xl text-gray-medium">
        From preventative medicine to chronic disease management, we're here to support your health journey
      </p>
    </div>
    
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
      {services.map((service, index) => (
        <div class={`fade-up animate-delay-${index * 100} group`}>
          <div class="h-full p-8 rounded-2xl bg-beige-light/50 hover:bg-beige-light transition-all duration-300 hover:shadow-lg hover:-translate-y-1">
            <div class="w-14 h-14 bg-teal-accent/20 rounded-xl flex items-center justify-center mb-6 group-hover:bg-teal-accent/30 transition-colors">
              <svg class="w-7 h-7 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={service.icon}></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold mb-3">{service.title}</h3>
            <p class="text-gray-medium">{service.description}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>