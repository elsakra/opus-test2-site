---
---

<section class="relative min-h-screen flex items-center overflow-hidden bg-gradient-to-br from-beige-light via-white to-white">
  <!-- Background shapes -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="parallax-shape absolute -top-40 -right-40 w-96 h-96 bg-coral/20 rounded-full blur-3xl"></div>
    <div class="parallax-shape absolute -bottom-40 -left-40 w-96 h-96 bg-teal-accent/20 rounded-full blur-3xl"></div>
  </div>
  
  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28 lg:py-32">
    <div class="grid lg:grid-cols-2 gap-12 items-center">
      <div class="space-y-8">
        <div class="space-y-4">
          <p class="hero-animate text-teal-primary font-medium text-lg">Est. 1996</p>
          <h1 class="hero-animate text-4xl md:text-5xl lg:text-6xl font-bold leading-tight tracking-tighter text-balance">
            Your health is our
            <span class="text-teal-primary">family tradition</span>
          </h1>
          <p class="hero-animate text-xl md:text-2xl text-gray-medium leading-relaxed">
            Board certified physicians providing the highest level of care in a friendly, comfortable environment for over 25 years.
          </p>
        </div>
        
        <div class="hero-animate flex flex-col sm:flex-row gap-4">
          <a href="https://mycw144.ecwcloud.com/portal20180/jsp/jspnew/preRegistration_new.jsp" class="btn-primary">
            Pre-Register Online
          </a>
          <a href="tel:6623491999" class="btn-secondary">
            Call (662) 349-1999
          </a>
        </div>
        
        <div class="hero-animate flex items-center gap-6 pt-4">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-teal-primary" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
            </svg>
            <span class="text-sm text-gray-medium">Same Day Appointments</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-teal-primary" fill="currentColor" viewBox="0 0 20 20">
              <path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path>
            </svg>
            <span class="text-sm text-gray-medium">Telehealth Available</span>
          </div>
        </div>
      </div>
      
      <div class="hero-animate relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img 
            src="https://res.cloudinary.com/dil14r8je/image/upload/v1768346069/auto-site-builder/opus-test2/image_13.jpg" 
            alt="Doctor and Patient consultation"
            class="w-full h-auto"
          />
        </div>
        <div class="absolute -bottom-6 -left-6 bg-white rounded-2xl shadow-xl p-6 max-w-xs">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-teal-accent/20 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-teal-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-navy">Open Today</p>
              <p class="text-sm text-gray-medium">7:00 AM - 5:00 PM</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>