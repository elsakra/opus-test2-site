---

<section class="section-animate py-20 md:py-28 lg:py-32 bg-gradient-to-br from-white to-beige-light/30">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 items-center">
      <div class="order-2 lg:order-1">
        <div class="relative">
          <div class="absolute -inset-4 bg-teal-accent/10 rounded-3xl blur-2xl"></div>
          <div class="relative grid grid-cols-2 gap-4">
            <div class="space-y-4">
              <img 
                src="https://res.cloudinary.com/dil14r8je/image/upload/v1768346069/auto-site-builder/opus-test2/image_11.jpg" 
                alt="Dr. Magdi Wassef"
                class="fade-up rounded-2xl shadow-lg w-full h-64 object-cover"
              />
              <div class="fade-up animate-delay-100 bg-white rounded-2xl p-6 shadow-lg">
                <p class="text-3xl font-bold text-teal-primary mb-1">30+</p>
                <p class="text-sm text-gray-medium">Years of Experience</p>
              </div>
            </div>
            <div class="space-y-4 pt-8">
              <div class="fade-up animate-delay-200 bg-white rounded-2xl p-6 shadow-lg">
                <p class="text-3xl font-bold text-teal-primary mb-1">2</p>
                <p class="text-sm text-gray-medium">Board Certified Physicians</p>
              </div>
              <img 
                src="https://res.cloudinary.com/dil14r8je/image/upload/v1768346069/auto-site-builder/opus-test2/image_12.jpg" 
                alt="Dr. Mary Missak"
                class="fade-up animate-delay-300 rounded-2xl shadow-lg w-full h-64 object-cover"
              />
            </div>
          </div>
        </div>
      </div>
      
      <div class="order-1 lg:order-2 space-y-6">
        <div class="space-y-4">
          <p class="fade-up text-teal-primary font-medium text-lg">About Our Practice</p>
          <h2 class="fade-up animate-delay-100 text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-balance">
            Dedicated to our patients
            <span class="text-teal-primary">since 1996</span>
          </h2>
        </div>
        
        <div class="space-y-4 text-lg text-gray-medium">
          <p class="fade-up animate-delay-200">
            Southaven Internal Medicine has been committed to providing our patients with the highest level of care in a friendly and comfortable environment. Our goal is to make our patients feel like they are family.
          </p>
          <p class="fade-up animate-delay-300">
            Led by Dr. Magdi Wassef and Dr. Mary Missak, our board certified physicians bring over 60 years of combined experience in internal medicine. We focus on preventative medicine, health screenings, and helping our community find solutions to the health challenges they face.
          </p>
        </div>
        
        <div class="fade-up animate-delay-300 flex flex-col sm:flex-row gap-4 pt-4">
          <a href="#providers" class="btn-primary">
            Meet Our Providers
          </a>
          <a href="https://www.facebook.com/southaveninternalmedicine" class="btn-secondary">
            Follow on Facebook
          </a>
        </div>
      </div>
    </div>
  </div>
</section>